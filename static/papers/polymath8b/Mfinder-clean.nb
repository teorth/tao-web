  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"zdegFinder", "[", "iplug_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
