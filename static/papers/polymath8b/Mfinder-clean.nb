            RowBox[{"pdl", "[", 
             RowBox[{"[", 
              RowBox[{"dg", "+", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"outplace", "=", 
