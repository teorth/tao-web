    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"OutCollection", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AddingSet", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Subsets", "[", 
        RowBox[{"SigToMultiply", ",", "SymmN"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"AddingSet", "\[NotEqual]", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"removeset", "=", 
         RowBox[{"AddingSet", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"leftovers", "=", "SigToMultiply"}], ";", 
