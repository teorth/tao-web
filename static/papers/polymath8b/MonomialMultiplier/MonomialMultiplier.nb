            RowBox[{"Drop", "[", 
             RowBox[{"removeset", ",", "1"}], "]"}]}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"removeset", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AddingSet", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{"1", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"SymmN", "-", 
                RowBox[{"Length", "[", 
                 RowBox[{"AddingSet", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "}"}]}], "]"}]}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newsig", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
