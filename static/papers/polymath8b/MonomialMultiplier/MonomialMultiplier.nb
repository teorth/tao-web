          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"TallyInfo", "=", 
         RowBox[{"Tally", "[", "removeset", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"newcount", "=", 
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{"Binomial", "[", 
