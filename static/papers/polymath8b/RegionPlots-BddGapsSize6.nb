Cell[BoxData[
 RowBox[{"RegionPlot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "+", "y"}], "\[LessEqual]", 
      RowBox[{"y", "+", "z"}], "\[LessEqual]", 
      RowBox[{"z", "+", "x"}], "\[LessEqual]", "0.7"}], ")"}], "&&", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"y", "\[LessEqual]", "x"}], "&&", 
      RowBox[{
       RowBox[{"x", "+", "y"}], "\[LessEqual]", "0.7"}], "&&", 
      RowBox[{
       RowBox[{"x", "+", "y", "+", "z"}], "\[LessEqual]", 
       RowBox[{"3", "/", "2"}]}]}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1.5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "1.5"}], "}"}], ",", 
   RowBox[{"{", 
