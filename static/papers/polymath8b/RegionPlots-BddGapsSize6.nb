Cell[BoxData[
 RowBox[{"RegionPlot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z", "+", "y"}], "\[LessEqual]", 
      RowBox[{"y", "+", "x"}], "\[LessEqual]", 
      RowBox[{"z", "+", "x"}], "\[LessEqual]", "0.7"}], ")"}], "&&", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"y", "\[LessEqual]", "x"}], "&&", 
      RowBox[{
       RowBox[{"x", "+", "y"}], "\[LessEqual]", "0.7"}], "&&", 
      RowBox[{
       RowBox[{"x", "+", "y", "+", "z"}], "\[LessEqual]", 
       RowBox[{"3", "/", "2"}]}]}], ")"}]}], ",", 
   RowBox[{"{", 
