Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RegionPlot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "+", "y"}], "\[LessEqual]", 
      RowBox[{"y", "+", "z"}], "\[LessEqual]", "0.7", "\[LessEqual]", "1.3", 
      "\[LessEqual]", 
      RowBox[{"z", "+", "x"}]}], ")"}], "&&", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"y", "\[LessEqual]", "x"}], "&&", 
      RowBox[{
