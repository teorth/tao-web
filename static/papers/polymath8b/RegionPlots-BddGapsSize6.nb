      RowBox[{"z", "+", "x"}], "\[LessEqual]", "0.7", "\[LessEqual]", "1.3", 
      "\[LessEqual]", 
      RowBox[{"x", "+", "y"}]}], ")"}], "&&", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"y", "\[LessEqual]", "x"}], "&&", 
      RowBox[{
